# =========================================================
# 教育 RAG 智能问答系统 - 环境配置模板
# 用法: cp .env.example .env  然后填入真实密钥
# 本文件不含任何真实密钥，可安全提交到 git。
# =========================================================

# ==================== 应用基础配置 ====================
APP_NAME=edu_rag
APP_ENV=development                 # development | production
APP_DEBUG=true                      # 生产环境务必关闭
APP_LOG_LEVEL=INFO
# 服务监听端口与地址
APP_HOST=0.0.0.0
APP_PORT=8888

# ==================== 数据库配置 (PostgreSQL/MySQL) ====================
# 关系库：存储会话与对话历史（SQLAlchemy 支持 postgresql/mysql/sqllite）
DB_HOST=localhost
DB_PORT=3306                        # MySQL=3306, PostgreSQL=5432
DB_NAME=edu_rag
DB_USER=root
DB_PASSWORD=change_me               # 生产环境必改
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false                       # 打印 SQL 日志，调试用
# 可选：若用 PostgreSQL 补充连接串，可覆盖上面的 host/port/user/password
# DATABASE_URL=postgresql+psycopg2://root:change_me@localhost:5432/edu_rag

# ==================== Redis配置 ====================
# 用途：会话状态、短期缓存、请求限流、流式输出队列
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                     # 若无密码留空
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5

# ==================== Milvus配置 ====================
# 向量库：文档 chunk 与 embeddings
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 推荐使用连接串（覆盖 host/port 的连接方式）
MILVUS_URI=http://localhost:19530
# 未启用密码验证时保留默认；若启用则按 Milvus 实际账号填写
MILVUS_USER=root
MILVUS_PASSWORD=Milvus
# 向量集合（collection）名称：向量库中的"表"
MILVUS_COLLECTION_NAME=document_embeddings
# 嵌入向量维度：必须与嵌入模型输出维度一致
#   千问 text-embedding-v3 = 1024（或 768/512 由模型参数决定）
#   BGE-M3               = 1024
#   text-embedding-3-small = 1536
MILVUS_DIMENSION=1024
# 索引类型与度量方式：如果数据量 < 100w 行，IVF_FLAT 即可
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=COSINE           # COSINE | IP | L2
# IVF_FLAT 索引参数：簇数量，一般取 16*sqrt(nRows) 邻近值
MILVUS_NLIST=1024

# ==================== LLM 模型配置 ====================
# 本系统 LLM 采用 OpenAI 兼容接口，Base URL + Key + Model 三件套即可切换
#
# --- 选项 A：阿里云 千问 (DashScope) ---
QWEN_API_KEY=your_qwen_api_key
QWEN_MODEL=qwen3.6-plus              # qwen-max / qwen-plus / qwen-turbo
# 千问 OpenAI 兼容端点（推荐，代码直接复用 openai sdk）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_TEMPERATURE=0.7
# QWEN_TOP_P=0.9
# QWEN_STREAM=true                    # 是否默认流式输出

# --- 选项 B：火山方舟 (Volcengine Ark) ---
HSFZ_API_KEY=your_volcengine_api_key
HSFZ_MODEL=ark-code-latest          # 在火山方舟控制台创建推理接入点后，填接入点 ID
HSFZ_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#HSFZ_TEMPERATURE=0.7
#HSFZ_TOP_P=0.9
#HSFZ_MAX_TOKENS=2000
# 模型代号优先级：1=HSFZ, 2=QWEN；留空或不设置则回退到 QWEN
#LLM_PROVIDER=hsfz                   # hsfz | qwen

# ==================== 嵌入模型配置 (SiliconFlow) ====================
# 用于将文档分块(chunk)向量化的模型，走 OpenAI 兼容接口
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_DIMENSION=1024   # 需与 MILVUS_DIMENSION 一致

# ==================== RAG 检索配置 ====================
# 召回条数
RAG_TOP_K=10
CANDIDATE_M=3
# 相似度阈值：低于该分数的 chunk 不进入回答上下文
RAG_SCORE_THRESHOLD=0.7
# 文档分块参数（字符数，中英文均可）
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50
# 知识库文件目录（入库脚本读取）
RAG_DATA_DIR=./data/ai_data